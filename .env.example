# Residential proxy for the DIY stealth stack (patchright_proxy.py).
# {session} and {country} are filled by the runner for sticky sessions.
# PROXY_URL is used if set; otherwise DIY_PROXY_SERVER_TEMPLATE.
PROXY_URL=http://USER,type_residential,country_{country},session_{session}:PASSWORD@gate.example.com:1080
DIY_PROXY_SERVER_TEMPLATE=http://USER,type_residential,country_{country},session_{session}:PASSWORD@gate.example.com:1080
DIY_PROXY_USERNAME_TEMPLATE=
DIY_PROXY_PASSWORD_TEMPLATE=

# Keep browser geography aligned with the proxy exit location.
DIY_PROXY_COUNTRY=US
DIY_PROXY_LOCALE=en-US
DIY_PROXY_TIMEZONE=America/New_York
DIY_PROXY_LANGUAGES=en-US,en
DIY_PROXY_LATITUDE=40.7128
DIY_PROXY_LONGITUDE=-74.0060

# Surfsky managed-browser benchmark credentials. Keep the API token only in .env.
SURFSKY_API_BASE_URL=https://your-account-api-host
SURFSKY_API_TOKEN=replace-with-secret
